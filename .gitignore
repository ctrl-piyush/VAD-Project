# Python environment and cache
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets
.env
.env.*
!.env.example

# Dataset and downloaded data
data/ucf_crime/videos/
data/ucf_crime/Train/
data/ucf_crime/Test/
*.zip

# Ignore generated artifacts by default
artifacts/*

# Keep dataset index and exact split
!artifacts/dataset/
artifacts/dataset/*
!artifacts/dataset/manifest.csv
!artifacts/dataset/split_manifest.json
!artifacts/dataset/validation_report.json

# Keep trained model checkpoint and run metadata
!artifacts/runs/
artifacts/runs/*
!artifacts/runs/transformer_frames_s42/
artifacts/runs/transformer_frames_s42/*
!artifacts/runs/transformer_frames_s42/best.pt
!artifacts/runs/transformer_frames_s42/last.pt
!artifacts/runs/transformer_frames_s42/config.json
!artifacts/runs/transformer_frames_s42/summary.json
!artifacts/runs/transformer_frames_s42/log.jsonl

# Do not upload cached feature files
artifacts/features/
